{
  "release": {
    "paths": [
      ".claude-plugin/plugin.json",
      "CHANGELOG.md",
      ".claude/context/feature-log.md"
    ],
    "evidence": []
  },
  "sync": {
    "branch_prefix": "sync/",
    "paths": [
      ".claude/skills/**",
      "scaffold/**"
    ],
    "evidence": [
      "synced_from"
    ]
  },
  "lanes": [
    {
      "name": "pipeline",
      "paths": [
        ".claude/skills/**",
        ".claude/hooks/**",
        ".claude/commands/**",
        ".claude/settings.json",
        ".claude/context/invariants.md",
        ".claude-plugin/**",
        "scaffold/**",
        "scripts/**",
        ".github/**",
        "evals/**",
        "AGENTS.md",
        "CLAUDE.md",
        "CONSTRAINTS.md"
      ],
      "evidence": [
        "review_verdict",
        "motivating_incident"
      ],
      "small_pr": {
        "max_changed_lines": 30,
        "exclude_paths": [".claude/hooks/**", ".claude/skills/gates/**", ".claude/skills/review/**", "scripts/check_*", "scripts/review_verdict.py", "scripts/install_*", "scripts/pipeline_lanes.json", "scaffold/pipeline_lanes.json", "scaffold/.claude/hooks/**", ".github/**"],
        "evidence": ["motivating_incident"]
      }
    }
  ],
  "default": {
    "name": "docs",
    "evidence": []
  },
  "review_carryover_paths": [
    "docs/*.md",
    "docs/pipeline-review/**",
    "CHANGELOG.md",
    "README.md"
  ],
  "carryover_paths": [
    ".claude/context/rejections.md",
    ".claude/context/incidents.md"
  ]
}
